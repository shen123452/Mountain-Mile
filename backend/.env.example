# =========================================================
# 山程 Mountain Mile · 后端环境变量模板
# 复制为 .env 后填入真实值；.env 不会被提交 Git
# =========================================================

# ── 应用 / 安全 ──
APP_ENV=development
SECRET_KEY=请用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173

# ── 数据库（PostgreSQL + pgvector）──
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/mountain_mile

# ── 阿里云百炼 / DashScope（OpenAI 兼容模式）──
DASHSCOPE_API_KEY=sk-xxxxxxxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_FALLBACK_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ── 阿里云 OSS ──
OSS_ACCESS_KEY_ID=LTAIxxxxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxxxx
OSS_BUCKET=your-bucket
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_PUBLIC_BASE=https://your-bucket.oss-cn-beijing.aliyuncs.com
